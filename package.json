{
  "name": "reversi",
  "version": "1.3.0",
  "private": true,
  "description": "Verteiltes Zwei-Personen-Reversi mit HTML, CSS und JavaScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/check.js",
    "start": "node server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4"
  }
}
