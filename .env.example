# Einstellungen des Servers. Kopieren nach .env und anpassen, dann starten mit
#   node --env-file=.env server/index.js
# (.env steht nicht im Repository.) Alle Werte sind optional.

# Port. Ein Port als Argument (npm start -- 4000) hat Vorrang.
PORT=3000

# Bedenkzeit pro Zug in Sekunden, 0.2 bis 600.
TURN_SECONDS=60

# Adresse, auf der der Server lauscht. Leer = alle Adressen, IPv4 und IPv6
# (so ist es für den Kursserver gedacht). Beim Entwickeln in einem fremden
# WLAN (Uni, Bahn) besser 127.0.0.1: Dann ist das Spiel nur auf dem eigenen
# Rechner erreichbar.
HOST=

# Höchstzahl gleichzeitiger Verbindungen von einer IP-Adresse, 2 bis 10000.
MAX_CONNECTIONS_PER_IP=50
